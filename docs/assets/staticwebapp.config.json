{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/api/*", "/assets/*", "/*.css", "/*.js", "/*.png", "/*.jpg", "/*.ico" ]
  },
  "routes": [
    {
      "route": "/glidezone",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/jobs",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [ "authenticated" ]
    }
  ]
}
